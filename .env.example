# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml.

# Long random string. Every service that verifies tokens must share it.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Only needed for AI lesson-plan generation (ai-service from Phase 2)
GEMINI_API_KEY=

# Optional: same value is shared by the dashboard (academic) and workflow insights (HOD)
WORKFLOW_ANON_SECRET=
