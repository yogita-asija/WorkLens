# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml.

# Long random string. EVERY service and the backend must share it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Only the ai-service needs this
GEMINI_API_KEY=

# Optional: use your Atlas database instead of the local MongoDB container.
# Backend, auth, leave and academic services all share it in this phase (the HOD module still reads these collections directly).
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Worklens
# The notification service has its OWN database, same cluster but a different name:
# NOTIFICATION_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/worklens_notification

# The messaging service (chat) also has its OWN database:
# MESSAGING_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/worklens_messaging

# Optional: same value is shared by the dashboard (academic) and workflow insights (HOD)
WORKFLOW_ANON_SECRET=
