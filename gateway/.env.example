# Copy to gateway/.env (git-ignored)

PORT=8000

# MUST be the same value as JWT_SECRET in backend/.env, otherwise every request is rejected with 401
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGIN=http://localhost:5173

# Phase 1: the existing backend, moved off port 8000 (set PORT=9000 in backend/.env)
MONOLITH_URL=http://localhost:9000

# Later phases: uncomment a line when that service is extracted. Left unset, its routes go to MONOLITH_URL.
# AUTH_URL=http://localhost:8001
# ACADEMIC_URL=http://localhost:8002
# LEAVE_URL=http://localhost:8003
# HOD_URL=http://localhost:8004
# MESSAGING_URL=http://localhost:8005
# NOTIFICATION_URL=http://localhost:8006
# AI_URL=http://localhost:8007

# Optional (default 120000). Long because AI lesson-plan generation can take a while.
# PROXY_TIMEOUT_MS=120000
