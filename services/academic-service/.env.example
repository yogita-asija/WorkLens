# Copy to services/academic-service/.env (git-ignored)

PORT=8002

# PHASE 4: the SAME database as backend/.env (same MONGO_URI). The data is not copied anywhere, so the old backend and this
# service always see the same records. It gets its own database (worklens_academic) when the HOD module is extracted (Phase 5).
MONGO_URI=mongodb://127.0.0.1:27017/worklens

# Same value as backend/.env and gateway/.env
JWT_SECRET=change-me-to-a-long-random-string

# Where users come from (auth-service) and where notifications go (notification-service)
AUTH_URL=http://localhost:8001
NOTIFICATION_URL=http://localhost:8006

# Same value as backend/.env (used to pseudonymise workflow feedback)
WORKFLOW_ANON_SECRET=
