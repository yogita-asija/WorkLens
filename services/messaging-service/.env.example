# Copy to services/messaging-service/.env (git-ignored)

PORT=8005

# Its OWN database. On Atlas, the same cluster as the backend but a different database name.
MONGO_URI=mongodb://127.0.0.1:27017/worklens_messaging

# Same value as backend/.env and gateway/.env
JWT_SECRET=change-me-to-a-long-random-string

# Where users come from (auth-service) and where notifications go (notification-service)
AUTH_URL=http://localhost:8001
NOTIFICATION_URL=http://localhost:8006

# Only matters if the browser talks to this service directly. Through the gateway the gateway's CORS_ORIGIN applies.
CLIENT_ORIGIN=http://localhost:5173
