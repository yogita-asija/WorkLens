# Copy to services/notification-service/.env (git-ignored)

PORT=8006

# Its OWN database. On Atlas, use the same cluster but a different database name than the backend's.
MONGO_URI=mongodb://127.0.0.1:27017/worklens_notification

# Same value as backend/.env and gateway/.env
JWT_SECRET=change-me-to-a-long-random-string
