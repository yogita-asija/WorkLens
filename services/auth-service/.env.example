# Copy to services/auth-service/.env (git-ignored)

PORT=8001

# TRANSITION: the SAME database as backend/.env. The `users` collection is still read directly by the HOD, leave
# and chat code in the backend, so it cannot move yet (see README). It gets its own database in the last phase.
MONGO_URI=mongodb://127.0.0.1:27017/worklens

# Same value as backend/.env and gateway/.env
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
